<?xml version="1.0" encoding="UTF-8"?>
<!--
    generation.xml — MTT ASCII Terrain Generation Rules
    Loaded by core/renderer/Ascii1/terrain_generation.py

    Edit this file to tweak world generation WITHOUT touching code.
    - Re-launch the renderer or delete saves_world1/ to see changes
      on already-generated chunks (they are cached as chunk_*.xml).
    - Values are hot-reloaded on import; call reload_generation_config()
      for live reload (e.g. debug hotkey).

    Structure:
      <settings>   Global chunk/world knobs.
      <noise>      Perlin noise parameters (requires `noise` lib, else fallback).
      <fallback>   Simple sin/cos noise when `noise` is absent.
      <terrain>    Ordered biome thresholds — first threshold_max >= noise wins.
      <ground_detail> Second noise layer splitting ground into sub-biomes.
      <mesa>       Rare large terracotta/dirt/gravel mask over ground.
      <variants>   Optional weighted glyph variants per biome (deterministic).
      <scatter>    Optional rare decor sprinkled over a biome (chance 0.0-1.0).

    Add a new biome: insert a <biome> with a threshold_max between neighbours.
    thresholds MUST be ascending; last should be 1.0 to catch all values.
-->
<generation version="1">

    <!-- ================= GLOBAL SETTINGS ================= -->
    <settings
        chunk_size="16"
        seed="0"
        save_dir="saves_world1"
    />

    <!-- ================= NOISE ================= -->
    <!-- scale = feature size (smaller = larger continents). octaves/persistence/lacunarity = detail -->
    <!-- Tuned for bigger water bodies: lower scale = larger continents/oceans, lower persistence = fewer tiny ponds -->
    <noise
        scale="0.032"
        octaves="3"
        persistence="0.42"
        lacunarity="2.0"
        seed_offset="0"
    />

    <!-- Used only when `noise` library is not installed -->
    <fallback scale="0.06" />

    <!-- ================= WHEAT FIELDS (clumps) ================= -->
    <!-- Wheat only spawns on ground plains. threshold = sparsity (higher = rarer, larger blobs need lower threshold).
         scale 0.08 = field size ~10 tiles; trampled_chance 0.65 = 65% of edge tiles become trampled ring (else normal wheat). -->
    <wheat_fields
        scale="0.08"
        octaves="2"
        threshold="0.38"
        trampled_chance="0.65"
        seed_offset="777"
        fallback_scale="0.10"
    />

    <!-- ================= GROUND DETAIL (sub-biomes) ================= -->
    <!-- Second noise layer that splits base 'ground' into patches so the new
         MTT tiles get real gameplay presence (own ASCII glyph + sprite).
         Matched first threshold_max >= detail_value wins; 'ground' = keep plains.
         Stumps are NOT a band (fields of stumps look wrong) — stump_chance rolls
         a rare single stump tile on plains instead. Wheat still wins over all.
         NOTE: terracotta is NOT listed here — it only spawns inside the mesa
         mask below. dark_grass is retired (never generates). -->
    <ground_detail
        scale="0.11"
        octaves="2"
        persistence="0.5"
        seed_offset="1234"
        fallback_scale="0.13"
        stump_chance="0.02"
    >
        <subbiome id="clay"       threshold_max="-0.45" char="c" color="205,102,29"  walkable="true" sprite="clay1.png"              name="Clay" />
        <subbiome id="dirt"       threshold_max="-0.15" char="d" color="139,69,19"   walkable="true" sprite="dirt1.png"              name="Dirt" />
        <subbiome id="ground"     threshold_max="0.30"  char="." color="34,139,34"   walkable="true" sprite="grass_plain1.png"       name="Plains" />
        <subbiome id="dry_grass"  threshold_max="0.45"  char="y" color="189,183,107" walkable="true" sprite="dry_grass1.png"         name="Dry Grass" />
        <subbiome id="muddy"      threshold_max="1.0"   char="m" color="121,85,58"   walkable="true" sprite="grass_muddy1.png"       name="Muddy Grass" />
        <!-- stump overlay: sprite grass_plain_with_stump1.png, char 'o', chance above -->
    </ground_detail>

    <!-- ================= MESA / BADLANDS (big rare terracotta blobs) ================= -->
    <!-- Low-frequency mask noise: where mask > threshold on base ground, tiles become
         a terracotta/dirt/gravel mix instead of normal detail. scale 0.025 = blobs
         ~40 tiles wide; threshold 0.35 = ~2% of land. Checked AFTER wheat (wheat wins)
         but BEFORE ground detail (mesas stay solid). Weights = mix inside the mesa. -->
    <mesa
        scale="0.025"
        octaves="2"
        persistence="0.5"
        threshold="0.35"
        seed_offset="5555"
        fallback_scale="0.03"
        terracotta_weight="50"
        dirt_weight="30"
        gravel_weight="20"
    />

    <!-- ================= PALETTE (optional overrides) ================= -->
    <!-- These mirror ascii.py defaults; edit here if you want XML-driven colours -->
    <palette>
        <color id="bg"         value="15,15,20"   />
        <color id="dark_gray"  value="40,40,50"   />
        <color id="player"     value="255,215,0"  />
        <color id="text"       value="220,220,220"/>
    </palette>

    <!-- ================= TERRAIN BIOMES ================= -->
    <!-- ORDER MATTERS: sorted by threshold_max ascending. noise val is ~ -1..1 -->
    <!-- water -> sand ring -> ground -> forest -> mountain. Sand sits in a narrow band above water so it only appears around water edges (beach). -->
    <!-- Tuned: water -0.20 = less water than before (-0.15), sand -0.14 = tan beach fringe only around water (adjacency enforced in code). -->
    <terrain>
        <biome id="water"    threshold_max="-0.20" char="~" color="65,105,225"   walkable="false" name="Water"    />
        <biome id="sand"     threshold_max="-0.14" char="." color="210,180,140"  walkable="true"  name="Sand"     />
        <biome id="ground"   threshold_max="0.20"  char="." color="34,139,34"    walkable="true"  name="Plains"   />
        <biome id="forest"   threshold_max="0.35"  char="T" color="0,100,0"      walkable="false" name="Forest"   />
        <biome id="mountain" threshold_max="1.0"   char="^" color="139,137,137"  walkable="false" name="Mountain" />
        <!-- Example: tweak water to -0.22 for even less water, or sand to -0.12 for wider beaches -->
    </terrain>

    <!-- ================= GLYPH VARIATION ================= -->
    <!-- Weighted random char per biome, seeded by world coords (deterministic). -->
    <variants>
        <biome_variants biome="ground">
            <variant char="." weight="70" />
            <variant char="," weight="15" />
            <variant char="`" weight="10" />
            <variant char="'" weight="5"  />
        </biome_variants>

        <biome_variants biome="sand">
            <variant char="." weight="60" />
            <variant char="," weight="20" />
            <variant char=":" weight="10" />
            <variant char="`" weight="10" />
        </biome_variants>

        <biome_variants biome="forest">
            <variant char="T" weight="60" />
            <variant char="t" weight="25" />
            <variant char="*" weight="15" />
        </biome_variants>

        <biome_variants biome="mountain">
            <variant char="^" weight="65" />
            <variant char="M" weight="20" />
            <variant char="A" weight="15" />
        </biome_variants>

        <biome_variants biome="water">
            <variant char="~" weight="80" />
            <variant char="-" weight="12" />
            <variant char="=" weight="8"  />
        </biome_variants>
    </variants>

    <!-- ================= SCATTER / DECOR ================= -->
    <!-- Rare features sprinkled on top of a biome. chance is per-tile (0.0-1.0) -->
    <scatter>
        <!-- Flowers / bushes on plains -->
        <feature biome="ground" char="*" color="50,205,50"   chance="0.015" walkable="true"  />
        <feature biome="ground" char="o" color="139,69,19"   chance="0.008" walkable="true"  />
        <feature biome="ground" char="%" color="255,215,0"   chance="0.005" walkable="true"  />
        <!-- Shells / pebbles on sand — beach only -->
        <feature biome="sand"   char="o" color="205,170,125" chance="0.012" walkable="true"  />
        <feature biome="sand"   char="*" color="255,228,181" chance="0.006" walkable="true"  />
        <!-- Rocks in mountains -->
        <feature biome="mountain" char="#" color="105,105,105" chance="0.02" walkable="false" />
        <!-- Lily pads / reeds on water edge (rare) -->
        <feature biome="water" char="=" color="0,191,255"    chance="0.01"  walkable="false" />
    </scatter>

</generation>

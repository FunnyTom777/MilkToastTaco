<?xml version="1.0" encoding="UTF-8" ?>
<!--
    config.xml — MTT ASCII Renderer Mode
    Loaded by core/renderer/Ascii1/ascii.py

    renderer_mode:
      1 = ASCII  (font glyphs, Courier 20pt — original mode)
      2 = Sprites (PNG tiles from assets/tiles/nature/)

    tile_size: pixel size for sprites (square). Viewport is SCREEN / tile_size.
    zoom: camera zoom multiplier (0.5 = zoomed out, 1.0 = normal, 2.0 = zoomed in).
          Scales tile_size/font and viewport. Hot-reload with R.
    Toggle via this file or hot-reload with R (re-reads config.xml).

    Add <debug>true</debug> to print missing sprite report on startup.

    Minimap (detail A = 2px/tile):
      <minimap> block toggles the top-right minimap. size = panel px (100..300),
      tile_px = minimap pixels per world tile (1..4). Detail A is 2.
      Toggle in-game with M.

    Fog-of-war (player-centered):
      <fog> is for the main viewport, not the minimap. Beyond 8 tiles the world is
            remembered dimmed — you see what you last saw there, not live updates.
      - enabled: master switch (true/false). Toggle in-game with F, but only when <debug>true</debug>.
      - radius: visible radius in tiles around player (0..32). Default 8. Fog starts beyond this.
      - persist: true = visited tiles stay dimmed as memory when you leave; false = snaps to fog.
      - dim_factor: 0.0..1.0 tint for remembered (fogged) tiles. 0.45 = dim, 1.0 = no dim.
      - save: true = persist memory across restarts to saves_world1/fog_memory.xml

    HUD:
      <hud> tweaks the overlay.
      - style: "solid" (opaque bar), "transparent" (alpha panel), "minimal" (tiny, no bg)
      - alpha: 0..255 transparency for transparent style
      - show_fps / show_coords / show_controls_hint: toggles
-->
<config version="1">
    <renderer_mode>2</renderer_mode>
    <tile_size>16</tile_size>
    <zoom>2.5</zoom>
    <debug>true</debug>

    <minimap>
        <enabled>true</enabled>
        <size>150</size>
        <tile_px>2</tile_px>
        <position>top_right</position>
        <border>true</border>
        <show_view_rect>true</show_view_rect>
    </minimap>

    <fog>
        <enabled>true</enabled>
        <radius>8</radius>
        <persist>true</persist>
        <dim_factor>0.45</dim_factor>
        <save>true</save>
    </fog>

    <hud>
        <style>transparent</style>
        <alpha>180</alpha>
        <show_fps>true</show_fps>
        <show_coords>true</show_coords>
        <show_controls_hint>true</show_controls_hint>
    </hud>
</config>
